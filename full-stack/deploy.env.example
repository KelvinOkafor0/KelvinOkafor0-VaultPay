# Production secret template. Fill these in your hosting provider; do not commit secrets.
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://YOUR_PUBLIC_DOMAIN
DATABASE_URL=SET_BY_HOSTING_PROVIDER
JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
ACCESS_TTL=15m
REFRESH_TTL=30d
KYC_PROVIDER=flutterwave
BANK_PROVIDER=flutterwave
CARD_PROVIDER=mock
WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
FLW_BASE_URL=https://api.flutterwave.com
FLW_SECRET_KEY=SET_IN_HOSTING_SECRET_STORE
FLW_SECRET_HASH=SET_IN_HOSTING_SECRET_STORE
FLW_KYC_REDIRECT_URL=https://YOUR_PUBLIC_DOMAIN/kyc/callback
API_INTERNAL_URL=SET_TO_PRIVATE_API_SERVICE
