NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://vaultpay:vaultpay@localhost:5432/vaultpay
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TTL=15m
REFRESH_TTL=30d

# Switch from mock to the real Nigerian provider when your Flutterwave account is approved.
KYC_PROVIDER=flutterwave
BANK_PROVIDER=flutterwave
CARD_PROVIDER=mock

# Flutterwave server-side secrets. NEVER put these in frontend code or Git.
FLW_BASE_URL=https://api.flutterwave.com
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_KYC_REDIRECT_URL=http://localhost:5173/kyc/callback

# Fallback demo webhook secret (used only by the old mock webhook route).
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
